{
  "name": "beacon-ai",
  "version": "0.1.0",
  "description": "Shine a light on your codebase's AI readiness. Lighthouse for AI coding agents.",
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "bin": {
    "beacon": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "keywords": [
    "ai",
    "code-quality",
    "developer-tools",
    "cli",
    "analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.49",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0",
    "toml": "^3.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "eslint": "^10.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.5.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0"
    }
  }
}
